// Regras de segurança do Cloud Firestore — Controle de Peças (Tecnopemt)
// Publicar em: console do Firebase → Firestore Database → Regras → colar tudo → Publicar.
// Testadas automaticamente no GitHub (rotina "Testar regras do banco") a cada alteração.
//
// Quem pode o quê:
//  - funcionário ATIVO logado (conta do Firebase ligada à ficha por contas/<uid> e que seja a conta
//    atual da ficha — campo authUid): lê e grava os dados do sistema;
//  - Administrador Master: tudo; administrador: gerencia funcionários comuns;
//  - quem está com cadastro pendente: só vê a própria ficha;
//  - cliente com link de assinatura (visitante anônimo): abre só o documento do link e grava só a
//    própria assinatura (uma vez), depois de acertar o código de 4 números (3 tentativas, validade, uso único);
//  - conta da rotina de backup (registrada em seguranca/backup pelo Master ou um administrador): só leitura;
//  - avaliação de desempenho: gestão registra/avalia; funcionário vê só o que foi aprovado para ele;
//  - qualquer outra pessoa: nada.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function anonimo() { return logado() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function emailConta() { return request.auth.token.get('email', ''); }
    // contas/<uid> diz de qual ficha é a conta (o e-mail interno não serve: o Firebase o deixa em minúsculas)
    function contaPath() { return /databases/$(database)/documents/contas/$(request.auth.uid); }
    function contaFuncionario() { return logado() && !anonimo() && exists(contaPath()); }
    function fid() { return get(contaPath()).data.funcionarioId; }
    // durante o próprio cadastro a ligação conta → ficha é criada no mesmo lote
    function fidNoLote() { return getAfter(contaPath()).data.funcionarioId; }
    function fichaPath() { return /databases/$(database)/documents/funcionarios/$(fid()); }
    function eu() { return get(fichaPath()).data; }
    // a conta logada é a conta ATUAL da ficha (redefinir a senha cria outra e derruba a antiga)
    function contaValida() { return contaFuncionario() && exists(fichaPath()) && eu().get('authUid', '') == request.auth.uid; }
    function ativo() {
      return contaValida() && (eu().get('status', '') == 'ativo' || (!('status' in eu()) && eu().get('ativo', true) != false));
    }
    function perfil() { return eu().get('perfil', 'funcionario'); }
    function master() { return ativo() && perfil() == 'master'; }
    function administrador() { return ativo() && perfil() in ['master', 'administrador']; }
    // quem pode cadastrar/editar funcionários: administradores e quem tem "Editar" em Equipe
    // (contas antigas sem permissões configuradas mantêm o acesso total que já tinham)
    function editaEquipe() {
      return administrador() || (ativo() && (!('permissoes' in eu()) || eu().permissoes.get('funcionarios', 'sem_acesso') == 'editar'));
    }
    function backup() {
      return logado() && !anonimo() && exists(/databases/$(database)/documents/seguranca/backup)
        && get(/databases/$(database)/documents/seguranca/backup).data.uid == request.auth.uid;
    }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- dados do sistema ----------
    match /{colecao}/{id} {
      allow read: if backup() || (ativo() && colecao in ['clientes', 'catalogoPecas', 'lotes', 'orcamentos', 'comissoes',
        'comissaoFechamentos', 'comissaoHistorico', 'apuracaoRegistros', 'regrasComissao', 'periodosApuracao',
        'avisos', 'notificacoes', 'config', 'pecas', 'exclusoes', 'midias', 'loginsPublicos', 'cpfs', 'backups', 'backupsCopias']);
      allow write: if ativo() && colecao in ['clientes', 'catalogoPecas', 'lotes', 'orcamentos', 'comissoes',
        'comissaoFechamentos', 'comissaoHistorico', 'apuracaoRegistros', 'regrasComissao', 'periodosApuracao',
        'avisos', 'notificacoes', 'config', 'pecas', 'exclusoes'];
    }

    // ---------- funcionários ----------
    match /funcionarios/{id} {
      // a própria ficha: inclusive pendente, bloqueado ou com a senha já redefinida (o sistema mostra o motivo)
      allow read: if ativo() || backup() || (contaFuncionario() && fid() == id);
      // cadastro pelo próprio funcionário: só como pendente, sem permissões, ligado à própria conta
      allow create: if (editaEquipe() && (master() || request.resource.data.get('perfil', 'funcionario') == 'funcionario'))
        || (logado() && !anonimo() && fidNoLote() == id
            && request.resource.data.get('status', '') == 'pendente'
            && request.resource.data.get('perfil', '') == 'funcionario'
            && request.resource.data.get('authUid', '') == request.auth.uid
            && request.resource.data.get('permissoes', {}).values().hasOnly(['sem_acesso']));
      allow update: if master()
        // administrador / quem edita a Equipe: só contas comuns, sem promover ninguém
        || (editaEquipe() && fid() != id
            && resource.data.get('perfil', 'funcionario') == 'funcionario'
            && request.resource.data.get('perfil', 'funcionario') == 'funcionario')
        // o próprio funcionário: dados pessoais e marcações de leitura (nunca perfil, status, permissões, comissão)
        || (ativo() && fid() == id && mudou().hasOnly(['nome', 'cpf', 'dataNascimento', 'telefone', 'cep', 'endereco',
            'numero', 'complemento', 'bairro', 'cidade', 'uf', 'login', 'cargo', 'avisosVistos',
            'notificacoesAniversarioVistas', 'atualizadoEm']));
      allow delete: if master();
    }

    // ---------- conta do Firebase → ficha do funcionário ----------
    match /contas/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      // a própria pessoa liga a conta dela (só vale se a ficha também apontar para esta conta: authUid)
      allow create: if (logado() && !anonimo() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['funcionarioId', 'email']))
        || editaEquipe();
      allow update, delete: if editaEquipe();
    }

    // ---------- login → conta interna (lido antes de entrar; não lista nada) ----------
    match /loginsPublicos/{login} {
      allow get: if true;
      allow create: if editaEquipe() || (logado() && !anonimo() && request.resource.data.email == emailConta());
      allow update, delete: if editaEquipe() || (ativo() && resource.data.email == emailConta());
    }

    // ---------- CPF já cadastrado (para o "Criar minha conta") ----------
    match /cpfs/{chave} {
      allow get: if logado() && !anonimo();
      allow create: if editaEquipe() || (logado() && !anonimo() && request.resource.data.funcionarioId == fidNoLote());
      allow update, delete: if editaEquipe() || (ativo() && resource.data.funcionarioId == fid());
    }

    // ---------- fotos e assinaturas ----------
    match /midias/{id} {
      allow get: if logado();
      allow list: if ativo() || backup();
      allow create: if logado();
      // reaproveitar uma imagem só acrescenta onde ela é usada; o conteúdo nunca muda
      allow update: if logado() && request.resource.data.dados == resource.data.dados;
      allow delete: if administrador();
    }

    // ---------- código de verificação da assinatura por link ----------
    // codigosAssinatura/<tipo>_<id>: código de 4 números que o cliente NÃO consegue ler. Cada tentativa do
    // cliente é registrada (no máximo 3); só a tentativa certa, dentro da validade, permite "confirmar"; e a
    // assinatura só é aceita junto com a marcação de "usado" (uso único).
    function codigoLiberado(tipo, id) {
      let caminho = /databases/$(database)/documents/codigosAssinatura/$(tipo + '_' + id);
      return exists(caminho) && get(caminho).data.get('usado', true) == false
        && getAfter(caminho).data.usado == true
        && getAfter(caminho).data.confirmado == true
        && getAfter(caminho).data.tentativaPor == request.auth.uid
        && getAfter(caminho).data.expiraEm > request.time;
    }
    function tipoAssinaturaOk(d) {
      return (d.tipo == 'entrada' && d.colecao == 'lotes' && d.campoAssinatura == 'assinaturaEntrada')
        || (d.tipo == 'entrega' && d.colecao == 'orcamentos' && d.campoAssinatura == 'assinaturaEntrega')
        || (d.tipo == 'teste' && d.colecao == 'orcamentos' && d.campoAssinatura == 'assinaturaTeste');
    }
    match /codigosAssinatura/{id} {
      allow read: if ativo();
      // quem já confirmou o código neste aparelho pode ver que confirmou (para recarregar a página)
      allow get: if logado() && resource.data.get('tentativaPor', '') == request.auth.uid && resource.data.get('confirmado', false) == true;
      // equipe gera (ou gera de novo) o código: 4 números, zerado, com validade de até 7 dias
      allow create, update: if ativo()
        && tipoAssinaturaOk(request.resource.data)
        && id == request.resource.data.tipo + '_' + request.resource.data.documentoId
        && request.resource.data.codigo is string && request.resource.data.codigo.matches('^[0-9]{4}$')
        && request.resource.data.tentativas == 0 && request.resource.data.tentativa == ''
        && request.resource.data.confirmado == false && request.resource.data.usado == false
        && request.resource.data.expiraEm > request.time
        && request.resource.data.expiraEm < request.time + duration.value(8, 'd');
      // cliente: 1) registra uma tentativa (conta mesmo se errar)
      allow update: if logado() && resource.data.usado == false && resource.data.confirmado == false
        && resource.data.expiraEm > request.time && resource.data.tentativas < 3
        && mudou().hasOnly(['tentativa', 'tentativas', 'tentativaPor', 'tentativaEm'])
        && request.resource.data.tentativas == resource.data.tentativas + 1
        && request.resource.data.tentativa is string && request.resource.data.tentativa.matches('^[0-9]{4}$')
        && request.resource.data.tentativaPor == request.auth.uid
        && request.resource.data.tentativaEm == request.time;
      //               2) confirma — só passa se a última tentativa registrada for a certa
      allow update: if logado() && resource.data.usado == false && resource.data.confirmado == false
        && resource.data.expiraEm > request.time
        && resource.data.tentativa == resource.data.codigo && resource.data.tentativaPor == request.auth.uid
        && mudou().hasOnly(['confirmado', 'confirmadoEm']) && request.resource.data.confirmado == true;
      //               3) gasta o código junto com a assinatura (uso único)
      allow update: if logado() && resource.data.usado == false && resource.data.confirmado == true
        && resource.data.tentativaPor == request.auth.uid && resource.data.expiraEm > request.time
        && mudou().hasOnly(['usado', 'usadoEm']) && request.resource.data.usado == true
        && resource.data.campoAssinatura in getAfter(/databases/$(database)/documents/$(resource.data.colecao)/$(resource.data.documentoId)).data;
      allow delete: if false;
    }

    // ---------- assinatura por link (cliente como visitante anônimo) ----------
    match /lotes/{id} {
      allow get: if anonimo();
      allow update: if anonimo() && codigoLiberado('entrada', id)
        && !('assinaturaEntrada' in resource.data)
        && mudou().hasOnly(['assinaturaEntrada', 'atualizadoEm']);
    }
    match /orcamentos/{id} {
      allow get: if anonimo();
      allow update: if anonimo()
        && mudou().hasOnly(['assinaturaEntrega', 'assinaturaTeste', 'historico', 'atualizadoEm'])
        && (!('assinaturaEntrega' in mudou()) || (codigoLiberado('entrega', id) && !('assinaturaEntrega' in resource.data)))
        && (!('assinaturaTeste' in mudou()) || (codigoLiberado('teste', id) && !('assinaturaTeste' in resource.data)))
        && request.resource.data.get('historico', []).hasAll(resource.data.get('historico', []))
        && request.resource.data.get('historico', []).size() <= resource.data.get('historico', []).size() + 1;
    }
    match /clientes/{id} {
      allow get: if anonimo();
    }

    // ---------- avaliação de desempenho ----------
    // Gestão (Master e administradores) registra, avalia e aprova; administrador não avalia o Master.
    // Funcionário: só as próprias avaliações APROVADAS, as metas liberadas para ele e — se a configuração
    // permitir — os próprios registros ativos. Nada é apagado: correções e remoções ficam no histórico.
    function gestor() { return administrador(); }
    // ninguém avalia a si mesmo; administrador não avalia o Master
    function alvoPermitido(fidAlvo) {
      return fidAlvo != fid()
        && (master() || get(/databases/$(database)/documents/funcionarios/$(fidAlvo)).data.get('perfil', 'funcionario') != 'master');
    }
    function registrosVisiveis() {
      return exists(/databases/$(database)/documents/avaliacaoConfig/geral)
        && get(/databases/$(database)/documents/avaliacaoConfig/geral).data.get('registrosVisiveisFuncionario', false) == true;
    }
    // restauração de backup (backup/restaurar.mjs): o Master grava as coleções como estavam, por tempo limitado
    function restauracao() {
      return master() && exists(/databases/$(database)/documents/seguranca/restauracao)
        && get(/databases/$(database)/documents/seguranca/restauracao).data.ate > request.time;
    }
    function listaCresce(campo, maximo) {
      return request.resource.data.get(campo, []).hasAll(resource.data.get(campo, []))
        && request.resource.data.get(campo, []).size() <= resource.data.get(campo, []).size() + maximo;
    }
    match /avaliacaoRegistros/{id} {
      allow write: if restauracao();
      allow read: if gestor() || backup()
        || (ativo() && resource.data.funcionarioId == fid() && resource.data.status == 'ativo' && registrosVisiveis());
      allow create: if gestor() && alvoPermitido(request.resource.data.funcionarioId)
        && request.resource.data.registradoPorId == fid()
        && request.resource.data.status == 'ativo'
        && request.resource.data.get('historicoAlteracoes', []).size() == 0
        && request.resource.data.descricao is string && request.resource.data.descricao.size() > 0;
      // correção ou remoção: sempre acrescenta exatamente uma entrada no histórico; quem registrou e quando não mudam
      allow update: if gestor() && alvoPermitido(resource.data.funcionarioId)
        && resource.data.status == 'ativo'
        && !mudou().hasAny(['funcionarioId', 'registradoPorId', 'registradoPorNome', 'registradoEm', 'origem'])
        && listaCresce('historicoAlteracoes', 1)
        && request.resource.data.get('historicoAlteracoes', []).size() == resource.data.get('historicoAlteracoes', []).size() + 1
        && (request.resource.data.status == 'ativo'
            || (request.resource.data.status == 'removido' && request.resource.data.get('justificativaRemocao', '').size() > 0));
      allow delete: if false;
    }
    match /avaliacaoConfig/{id} {
      allow read: if ativo() || backup();
      allow write: if gestor();
    }
    match /avaliacoesTrimestrais/{id} {
      allow write: if restauracao();
      allow read: if gestor() || backup();
      // uma por funcionário e trimestre (id = funcionario_AAAA-Tn), nasce como rascunho
      allow create: if gestor() && alvoPermitido(request.resource.data.funcionarioId)
        && id == request.resource.data.funcionarioId + '_' + request.resource.data.trimestre
        && request.resource.data.status == 'rascunho';
      allow update: if gestor() && alvoPermitido(resource.data.funcionarioId)
        && !mudou().hasAny(['funcionarioId', 'trimestre', 'geradoEm'])
        && listaCresce('versoes', 1) && listaCresce('historico', 1)
        && (
          // em edição: livre até aprovar
          (resource.data.status in ['rascunho', 'em_revisao'] && request.resource.data.status in ['rascunho', 'em_revisao', 'aprovada'])
          // aprovada: só registrar o feedback…
          || (resource.data.status in ['aprovada', 'feedback'] && request.resource.data.status == 'feedback'
              && mudou().hasOnly(['status', 'feedbackEm', 'feedbackPorId', 'feedbackPorNome', 'compromissosFeedback', 'historico']))
          // …ou reabrir para correção guardando a versão aprovada, com justificativa
          || (resource.data.status in ['aprovada', 'feedback'] && request.resource.data.status == 'em_revisao'
              && mudou().hasOnly(['status', 'versoes', 'historico'])
              && request.resource.data.get('versoes', []).size() == resource.data.get('versoes', []).size() + 1
              && request.resource.data.versoes[request.resource.data.versoes.size() - 1].get('justificativa', '').size() > 0)
        );
      allow delete: if false;
    }
    // versão aprovada que o funcionário vê (só existe se a avaliação estiver aprovada)
    match /avaliacoesPublicadas/{id} {
      allow write: if restauracao();
      allow read: if gestor() || backup() || (ativo() && resource.data.funcionarioId == fid());
      allow write: if gestor() && alvoPermitido(request.resource.data.funcionarioId)
        && getAfter(/databases/$(database)/documents/avaliacoesTrimestrais/$(id)).data.status in ['aprovada', 'feedback']
        && getAfter(/databases/$(database)/documents/avaliacoesTrimestrais/$(id)).data.funcionarioId == request.resource.data.funcionarioId;
      allow delete: if false;
    }
    match /avaliacaoMetas/{id} {
      allow write: if restauracao();
      allow read: if gestor() || backup()
        || (ativo() && resource.data.funcionarioId == fid() && resource.data.visivelFuncionario == true);
      allow create: if gestor() && alvoPermitido(request.resource.data.funcionarioId);
      allow update: if gestor() && alvoPermitido(resource.data.funcionarioId)
        && !mudou().hasAny(['funcionarioId', 'criadoPorId', 'criadoEm'])
        && listaCresce('historico', 1) && listaCresce('comentarios', 1)
        && (request.resource.data.status != 'Cancelada' || resource.data.status == 'Cancelada'
            || request.resource.data.get('justificativaCancelamento', '').size() > 0);
      allow delete: if false;
    }

    // ---------- configuração de segurança (Master e administradores: conta da rotina de backup) ----------
    match /seguranca/{id} {
      allow read, write: if administrador();
    }
  }
}
