// Regras do Firestore em vigor até a migração para o login do Firebase (copiadas do console em 28/10/2026).
// ATENÇÃO: estas regras deixam o banco aberto a qualquer pessoa. Guardadas só como registro/reversão.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
